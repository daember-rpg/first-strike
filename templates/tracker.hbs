{{#if hasCombat}}
<div class="fs-stack">
<div class="fs-panel--bar {{#if isGM}}fs-panel--gm{{/if}}">
  <div class="first-strike-tracker__toggle fs-bar__lead" title="{{#if started}}Round {{round}}{{else}}Preparing encounter{{/if}} - drag to move, click to collapse">
    <span class="fs-bar__round" aria-label="{{#if started}}Round {{round}}{{else}}Preparing encounter{{/if}}">{{#if started}}R{{round}}{{else}}&hellip;{{/if}}</span>
  </div>

  {{#unless collapsed}}
    <div class="fs-strip" role="list" aria-label="Initiative order">
      {{#each combatants as |c|}}
        {{> first-strike-card c}}
      {{/each}}
    </div>

    {{#if turnBar}}
      <div class="fs-bar__turn">
        <span class="fs-bar__btn" data-action="delay-turn" data-combatant-id="{{turnBar.id}}" title="Delay turn"><i class="fa-solid fa-hourglass-start"></i></span>
        <span class="fs-bar__btn fs-bar__btn--end" data-action="end-turn" data-combatant-id="{{turnBar.id}}" title="End turn"><i class="fa-solid fa-check"></i></span>
      </div>
    {{/if}}
  {{/unless}}

</div>
<div class="fs-drawer {{#unless isGM}}fs-drawer--quiet{{/unless}}">
  {{#if isGM}}
    {{#if started}}
      <i class="fa-solid fa-backward-fast fs-control" data-action="previous-round" title="Previous round"></i>
      <i class="fa-solid fa-backward-step fs-control" data-action="previous-turn" title="Previous turn"></i>
      <i class="fa-solid fa-dice fs-control" data-action="roll-npc" title="Roll all NPC initiative"></i>
      <i class="fa-solid fa-forward-step fs-control" data-action="next-turn" title="Next turn"></i>
      <i class="fa-solid fa-forward-fast fs-control" data-action="next-round" title="Next round"></i>
      <i class="fa-solid fa-xmark fs-control fs-control--end-encounter" data-action="end-combat" title="End encounter"></i>
    {{else}}
      <i class="fa-solid fa-dice fs-control" data-action="roll-npc" title="Roll all NPC initiative"></i>
      <i class="fa-solid fa-swords fs-control fs-control--begin-icon" data-action="begin-encounter" title="Begin encounter"></i>
    {{/if}}
  {{/if}}
</div>
</div>
{{else if isGM}}
<div class="fs-panel fs-panel--setup">
  <div class="first-strike-tracker__toggle">
    <span class="first-strike-tracker__round">No active encounter</span>
  </div>
  <div class="fs-setup-body">
    <span class="fs-control fs-control--begin" data-action="begin-encounter"><i class="fa-solid fa-swords"></i> Begin encounter</span>
  </div>
</div>
{{/if}}
