{{#if hasCombat}}
<div class="fs-panel {{#if isGM}}fs-panel--gm{{/if}}">
  <div class="first-strike-tracker__toggle">
    <span class="first-strike-tracker__round">{{#if started}}Round {{round}}{{else}}Preparing encounter{{/if}}</span>
    <span class="first-strike-tracker__count">{{combatantCount}} combatants</span>
    <i class="fa-solid {{#if stripMode}}fa-list{{else}}fa-table-cells{{/if}} first-strike-tracker__mode-toggle" data-mode-toggle title="{{#if stripMode}}Switch to list view{{else}}Switch to strip view{{/if}}"></i>
    <i class="fa-solid {{#if stripMode}}{{#if collapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}{{else}}{{#if collapsed}}fa-chevron-up{{else}}fa-chevron-down{{/if}}{{/if}} first-strike-tracker__caret"></i>
  </div>

  {{#unless collapsed}}
    {{#if stripMode}}
      <div class="fs-strip">
        {{#each combatants as |c|}}
          {{> first-strike-card c}}
        {{/each}}
      </div>

      {{#if turnBar}}
        <div class="fs-turnbar">
          <span class="fs-turnbar__label">{{turnBar.label}}</span>
          <span class="fs-turnbar__btn" data-action="delay-turn" data-combatant-id="{{turnBar.id}}"><i class="fa-solid fa-hourglass-start"></i> Delay</span>
          <span class="fs-turnbar__btn fs-turnbar__btn--end" data-action="end-turn" data-combatant-id="{{turnBar.id}}"><i class="fa-solid fa-circle-check"></i> End turn</span>
        </div>
      {{/if}}
    {{else}}
      <div class="fs-list">
        {{#each combatants as |c|}}
          {{> first-strike-row c}}
        {{/each}}
      </div>
    {{/if}}

    {{#if isGM}}
      {{#if started}}
        <div class="fs-tracker-controls">
          <i class="fa-solid fa-backward-fast fs-control" data-action="previous-round" title="Previous round"></i>
          <i class="fa-solid fa-backward-step fs-control" data-action="previous-turn" title="Previous turn"></i>
          <i class="fa-solid fa-dice fs-control" data-action="roll-npc" title="Roll all NPC initiative"></i>
          <span class="fs-control fs-control--end" data-action="end-combat"><i class="fa-solid fa-flag-checkered"></i> End encounter</span>
          <i class="fa-solid fa-forward-step fs-control" data-action="next-turn" title="Next turn"></i>
          <i class="fa-solid fa-forward-fast fs-control" data-action="next-round" title="Next round"></i>
        </div>
      {{else}}
        <div class="fs-tracker-controls">
          <i class="fa-solid fa-dice fs-control" data-action="roll-npc" title="Roll all NPC initiative"></i>
          <span class="fs-control fs-control--begin" data-action="begin-encounter"><i class="fa-solid fa-dice-d20"></i> Begin encounter</span>
        </div>
      {{/if}}
    {{/if}}
  {{/unless}}
</div>
{{else if isGM}}
<div class="fs-panel fs-panel--setup">
  <div class="first-strike-tracker__toggle">
    <span class="first-strike-tracker__round">No active encounter</span>
  </div>
  <div class="fs-setup-body">
    <span class="fs-control fs-control--begin" data-action="begin-encounter"><i class="fa-solid fa-dice-d20"></i> Begin encounter</span>
  </div>
</div>
{{/if}}
