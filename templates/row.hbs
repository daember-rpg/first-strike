<div class="fs-row fs-row--{{disposition}} {{#if isActive}}fs-row--active{{/if}} {{#if isUpcoming}}fs-row--upcoming{{/if}} {{#if isDefeated}}fs-row--defeated{{/if}} {{#if isHidden}}fs-row--hidden{{/if}} {{#if isDelayed}}fs-row--delayed{{/if}}"
     data-combatant-id="{{id}}">
  <div class="fs-row__portrait" style="background-image: url('{{img}}');"></div>
  <div class="fs-row__body">
    <div class="fs-row__top">
      <span class="fs-row__name">{{name}}</span>

      {{#if isHidden}}
        <i class="fa-solid fa-eye-slash fs-row__hidden-icon" title="Hidden from players"></i>
      {{/if}}

      {{#if surprisedActive}}
        <i class="fa-solid fa-moon fs-row__surprise-icon" title="Surprised - won't act this round"></i>
      {{else if canToggleSurprise}}
        <i class="fa-regular fa-moon fs-row__surprise-icon fs-row__surprise-icon--toggle"
           data-action="toggle-surprised" data-combatant-id="{{id}}" title="Mark as surprised"></i>
      {{/if}}

      {{#if isDefeated}}
        <i class="fa-solid fa-skull fs-row__skip-icon" title="Defeated - turn skipped"></i>
      {{else if isDelayed}}
        <i class="fa-solid fa-hourglass fs-row__delay-icon" title="Delaying"></i>
        {{#if canRoll}}
          <i class="fa-solid fa-bolt fs-row__act-now" data-action="act-now" data-combatant-id="{{id}}" title="Act now"></i>
        {{/if}}
      {{else if hasInitiative}}
        <span class="fs-row__initiative" title="{{#if @root.isGM}}Double-click to edit{{/if}}">{{initiative}}</span>
        {{#if isActive}}
          {{#if canRoll}}
            <i class="fa-solid fa-hourglass-start fs-row__delay" data-action="delay-turn" data-combatant-id="{{id}}" title="Delay turn"></i>
            <i class="fa-solid fa-circle-check fs-row__end-turn" data-action="end-turn" data-combatant-id="{{id}}" title="End turn"></i>
          {{/if}}
        {{/if}}
      {{else if canRoll}}
        <i class="fa-solid fa-dice-d20 fs-row__roll" data-action="roll-initiative" data-combatant-id="{{id}}" title="Roll initiative"></i>
      {{else}}
        <span class="fs-row__initiative fs-row__initiative--pending">-</span>
      {{/if}}
    </div>

    {{#if statusIcons}}
      <div class="fs-row__statuses">
        {{#each statusIcons as |s|}}
          <img src="{{s.img}}" title="{{s.label}}" class="fs-row__status-icon" />
        {{/each}}
      </div>
    {{/if}}

    {{#if hpVisible}}
      <div class="fs-hp-bar">
        <div class="fs-hp-bar__fill fs-hp-bar__fill--{{hp.band}}" style="width: {{hp.pct}}%;"></div>
      </div>
      <div class="fs-row__footer">
        <span class="fs-row__hp-value">{{hp.value}}/{{hp.max}}</span>
      </div>
    {{else if hasHp}}
      <div class="fs-hp-bar">
        <div class="fs-hp-bar__fill fs-hp-bar__fill--high" style="width: 100%;"></div>
      </div>
    {{/if}}
  </div>
</div>
