<div class="fs-card fs-card--{{disposition}} {{#if isActive}}fs-card--active{{/if}} {{#if isNext}}fs-card--next{{/if}} {{#if isDefeated}}fs-card--defeated{{/if}} {{#if isHidden}}fs-card--hidden{{/if}} {{#if isDelayed}}fs-card--delayed{{/if}}"
     data-combatant-id="{{id}}"
     title="{{name}}{{#if hpVisible}} - {{hp.value}}/{{hp.max}} HP{{/if}}{{#if isNext}} (next){{/if}}">
  <div class="fs-card__portrait" style="background-image: url('{{img}}');">
    {{#if isNext}}<span class="fs-card__next">Next</span>{{/if}}

    {{#if surprisedActive}}
      <i class="fa-solid fa-moon fs-card__flag fs-card__flag--left fs-card__flag--surprised" title="Surprised - won't act this round"></i>
    {{else if canToggleSurprise}}
      <i class="fa-regular fa-moon fs-card__flag fs-card__flag--left fs-card__flag--toggle" data-action="toggle-surprised" data-combatant-id="{{id}}" title="Mark as surprised"></i>
    {{/if}}
    {{#if isHidden}}
      <i class="fa-solid fa-eye-slash fs-card__flag fs-card__flag--right" title="Hidden from players"></i>
    {{/if}}

    {{#if isDelayed}}
      {{#if canRoll}}
        <span class="fs-card__center" data-action="act-now" data-combatant-id="{{id}}" title="Act now"><i class="fa-solid fa-bolt"></i></span>
      {{else}}
        <span class="fs-card__center fs-card__center--static" title="Delaying"><i class="fa-solid fa-hourglass"></i></span>
      {{/if}}
    {{else if hasInitiative}}
      <div class="fs-card__badge"><span class="fs-card__init" title="{{#if @root.isGM}}Double-click to edit{{/if}}">{{initiative}}</span></div>
    {{else if canRoll}}
      <span class="fs-card__center" data-action="roll-initiative" data-combatant-id="{{id}}" title="Roll initiative"><i class="fa-solid fa-dice-d20"></i></span>
    {{else}}
      <div class="fs-card__badge"><span class="fs-card__pending">-</span></div>
    {{/if}}
  </div>

  <div class="fs-card__hp">
    {{#if hpVisible}}
      <div class="fs-hp-bar"><div class="fs-hp-bar__fill fs-hp-bar__fill--{{hp.band}}" style="width: {{hp.pct}}%;"></div></div>
    {{else if hasHp}}
      <div class="fs-hp-bar"><div class="fs-hp-bar__fill fs-hp-bar__fill--high" style="width: 100%;"></div></div>
    {{/if}}
  </div>
</div>
